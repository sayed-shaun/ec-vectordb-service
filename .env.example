# Copy to .env and adjust. .env is gitignored.
#
# Only what differs per environment is listed. Every other setting has a
# default in src/core/config.py and can still be overridden by an env var of
# the same name.

QDRANT_URL=http://localhost:6333

# cpu (default), cuda, or auto (cuda when available, else cpu). A CPU-resident
# model runs fp32 regardless of DTYPE.
DEVICE=cpu

# Lets POST /reindex (and scripts/fetch_dataset.sh) download the private
# dataset. Scope required: repo (read).
GITHUB_TOKEN=

# Optional: when set, /reindex requires it as the X-Reindex-Token header.
REINDEX_TOKEN=
