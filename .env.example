# Copy to .env only to override a default. Nothing here is required: every
# setting has a default in src/core/config.py, and an env var of the same name
# (from the environment or .env) overrides it. .env is gitignored.

# QDRANT_URL=http://localhost:6333

# auto (default): CUDA when available, else CPU. Or force cpu / cuda. A
# CPU-resident model runs fp32 regardless of DTYPE.
# DEVICE=auto
