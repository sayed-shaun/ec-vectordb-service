# Copy to .env and adjust. .env is gitignored.

QDRANT_URL=http://localhost:6333
COLLECTION=ec_documents

# The only setting that differs between this workstation and the GPU server.
#   cpu   - everything on CPU (default; what this box runs)
#   cuda  - everything on the GPU (the server)
#   auto  - cuda when available, else cpu
DEVICE=cpu
DTYPE=float32

# Split across devices when the card cannot hold all three in fp16.
# Example for a 4 GB card: two on the GPU, one left on CPU (~2.2 GB VRAM).
#   DEVICE=cuda
#   DTYPE=float16
#   DEVICE_OVERRIDES={"bge_m3":"cpu"}
DEVICE_OVERRIDES={}

# Logging. The file is hard-capped: past LOG_MAX_BYTES it is truncated
# and starts again, so the service cannot fill a disk. Leave LOG_FILE
# empty to log to the console only (e.g. when a log driver already collects
# stdout). LOG_BACKUP_COUNT=0 truncates; raise it to keep that many
# previous files instead, costing (backups + 1) x the cap on disk.
LOG_LEVEL=INFO
LOG_FILE=logs/ec-vectordb.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=0

CANDIDATE_MULTIPLIER=4
RRF_K=60

# How many of the three models must independently pick the same tag before the
# answer is returned. Below this, unable_to_answer is returned instead.
MIN_MODEL_AGREEMENT=2

# The matched question must reach this cosine, else unable_to_answer is
# returned. Calibrated on the complete 17,995-point index.
MIN_COSINE=0.78

# A tag's answer at or below this length is a placeholder that escaped into
# published data (e.g. `fraction` -> "tag"), not a real answer. Refused the
# same as a similarity or agreement failure.
MIN_ANSWER_CHARS=4

# Follow-up rewriting. A bare "how much?" is rewritten into a standalone
# question by this external service before retrieval sees it. Empty disables
# the call entirely -- the raw question is used unchanged, which is what
# tests and local dev run with.
REWRITE_URL=
REWRITE_TIMEOUT_S=3.0

# chat_id lets the server hold a conversation's turns in memory instead of the
# caller echoing `history` back each turn. Per-process, not shared across
# workers or replicas -- see src/core/memory.py. Idle past the TTL, or
# past the count cap, a conversation is forgotten.
SESSION_TTL_S=1800
SESSION_MAX_COUNT=10000

EMBED_BATCH_SIZE=16
EAGER_LOAD_MODELS=false

# Only needed to re-download the private dataset in CI or on a machine with no
# authenticated `gh` CLI. On a workstation where `gh auth status` is green,
# leave this empty -- the token stays in the OS keyring, which is safer than a
# file on disk. Scope required: repo (read).
GITHUB_TOKEN=
