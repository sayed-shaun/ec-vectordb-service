# Copy to .env only to override a default. Nothing here is required: every
# setting has a default in src/core/config.py, and an env var of the same name
# (from the environment or .env) overrides it. .env is gitignored.

# QDRANT_URL=http://localhost:6333

# cuda (default): the GPU, degrading to CPU with a warning when none is usable.
# Set cpu to run on the CPU on purpose, or auto to pick whichever is available.
# A CPU-resident model runs fp32 regardless of DTYPE.
# DEVICE=cuda
